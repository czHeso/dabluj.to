# Patterns for runtime data are ANCHORED with a leading slash so they match
# only at the repository root. An unanchored `models/` also matches
# `backend/src/dabuj/models/`, which would silently drop a source package from
# every clone. See tests/unit/test_packaging.py, which guards against exactly
# that.

# --- Python -----------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
/build/
/dist/
.venv/
venv/
.env
.mypy_cache/
.ruff_cache/
.pytest_cache/
.coverage
coverage.xml
htmlcov/

# --- Node / frontend --------------------------------------------------------
node_modules/
frontend/dist/
frontend/.vite/
*.local

# --- AI model weights: never committed --------------------------------------
# Models are multi-gigabyte and carry their own licences. They are downloaded
# at runtime into the user's data directory. See docs/MODELS.md.
/models/
*.onnx
*.gguf
*.bin
*.pt
*.safetensors
*.ckpt

# --- Application runtime data -----------------------------------------------
# Projects, caches and logs must never land in the repository.
/projects/
/cache/
.dabuj/
*.log

# --- Media: test media and user media stay out of git -----------------------
*.mkv
*.mp4
*.mov
*.webm
*.mp3
*.m4a
*.aac
*.flac
*.opus
*.ogg
# Tiny generated fixtures are the one exception (see tests/fixtures/README.md).
!tests/fixtures/**/*.wav

# --- OS / editor ------------------------------------------------------------
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
